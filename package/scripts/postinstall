#!/bin/bash
set -euo pipefail

APP_MACOS="/Applications/osxrdp/OSXRDP.app/Contents/MacOS"
XRDP_CONFIG_DIR="/etc/xrdp"
RUNTIME_DIR="/var/run/osxrdp"
TEMP_DIR="$(mktemp -d /private/tmp/osxrdp-postinstall.XXXXXX)"
trap 'status=$?; rm -rf "$TEMP_DIR"; exit "$status"' EXIT
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=install_helpers.sh
source "$SCRIPT_DIR/install_helpers.sh"

mkdir -p "$XRDP_CONFIG_DIR"

# Preserve all service identities across ordinary upgrades.
osxrdp_ensure_rdp_identity "$APP_MACOS" "$XRDP_CONFIG_DIR" "$TEMP_DIR"
osxrdp_ensure_tls_identity "$XRDP_CONFIG_DIR" "$TEMP_DIR"

touch /var/log/xrdp.log
mkdir -p /Library/Logs/osxrdp
chmod 755 /Library/Logs/osxrdp

# Create the root-only sessionmanager socket directory and reject symlinks.
if [[ -L "$RUNTIME_DIR" ]]; then
    echo "ERROR: $RUNTIME_DIR must not be a symbolic link." >&2
    exit 1
fi
mkdir -p "$RUNTIME_DIR"
chown root:wheel "$RUNTIME_DIR"
chmod 700 "$RUNTIME_DIR"
if [[ "$(stat -f '%u:%g:%Lp' "$RUNTIME_DIR")" != "0:0:700" ]]; then
    echo "ERROR: invalid owner or mode on $RUNTIME_DIR" >&2
    exit 1
fi

# Remove only the obsolete, fixed-name socket from pre-migration releases.
if [[ -S /tmp/osxrdpsessionmanager ]]; then
    rm -f /tmp/osxrdpsessionmanager
fi

xattr -dr com.apple.quarantine /Applications/osxrdp 2>/dev/null || true
xattr -d com.apple.quarantine /Library/LaunchDaemons/com.byungho.osxrdp.plist 2>/dev/null || true
xattr -d com.apple.quarantine /Library/LaunchDaemons/com.byungho.osxrdp.sessionmanager.plist 2>/dev/null || true
xattr -d com.apple.quarantine /Library/LaunchAgents/com.byungho.osxrdp.lockscreen.plist 2>/dev/null || true

osxrdp_restart_daemon "com.byungho.osxrdp" "/Library/LaunchDaemons/com.byungho.osxrdp.plist"
osxrdp_restart_daemon "com.byungho.osxrdp.sessionmanager" "/Library/LaunchDaemons/com.byungho.osxrdp.sessionmanager.plist"

# The LoginWindow-scoped LaunchAgent is loaded by launchd for the next matching
# session. A package script runs as root and must not bootstrap it into gui/0.
